# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A SWAR memchr written in OxCaml, benchmarked against C and Rust"
description:
  "Two implementations of memchr in OxCaml -- one idiomatic and recursive, one optimized with mutable locals and a ctz-based tail -- both using unboxed int64# arithmetic and checked zero-alloc. Includes a core_bench suite comparing them against glibc's vectorized memchr, hand-written SWAR in C and Rust, and Bytes.index_opt from the stdlib. Requires an OxCaml switch; this will not build on stock OCaml."
maintainer: ["Keith Yeung <kungfukeith11@gmail.com>"]
authors: ["Keith Yeung <kungfukeith11@gmail.com>"]
license: "MIT"
tags: ["memchr" "swar" "simd" "string-search" "benchmark" "oxcaml"]
homepage: "https://github.com/KiChjang/ml-memchr"
bug-reports: "https://github.com/KiChjang/ml-memchr/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2"}
  "base"
  "core"
  "core_bench"
  "core_unix"
  "ocaml_intrinsics"
  "ocaml_simd_avx"
  "ocaml_simd_sse"
  "ppx_assert"
  "ppx_inline_test"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/KiChjang/ml-memchr.git"
x-maintenance-intent: ["(latest)"]
